name: Publish to pub.dev

on:
  push:
    branches:
      - main

permissions:
  contents: write
  id-token: write

# Serialize publish runs: the bump step commits to main, and parallel runs
# race on the git push (non-fast-forward) and burn version tags.
concurrency:
  group: publish-main
  cancel-in-progress: false

jobs:
  publish:
    runs-on: ubuntu-latest
    if: "!contains(github.event.head_commit.message, '[pub bump]')"
    steps:
      - name: Checkout
        uses: actions/checkout@v4
        with:

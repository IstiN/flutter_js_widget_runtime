lib/src/loader:
asset_widget_file_reader.dart
widget_file_reader.dart

lib/src/model:
js_runtime_config.dart
widget_manifest.dart

lib/src/widgets:
js_key_events.dart
js_keyboard_capture.dart
js_widget_app.dart
js_widget_demo_menu.dart
js_widget_runtime_widget.dart
name: js_widget_runtime_example
description: Example app demonstrating js_widget_runtime.
publish_to: 'none'
version: 0.1.0

environment:
  sdk: '>=3.12.0 <4.0.0'
  flutter: '>=3.19.0'

dependencies:
  flutter:
    sdk: flutter

  js_widget_runtime:
    path: ../

dev_dependencies:
  flutter_test:
    sdk: flutter
  flutter_lints: ^6.0.0

flutter:
  uses-material-design: true
  assets:
    - widgets/yolo-hello/
    - widgets/calculator/
    - widgets/animation-showcase/
    - widgets/weather/
    - widgets/stocks/
    - widgets/crypto/
    - widgets/3d-viewer/
    - widgets/3d-showcase/
    - widgets/3d-glb-showcase/
    - widgets/3d-game-dodge/
    - widgets/fitness-trainer/
    - widgets/m3-showcase/
    - widgets/charts-showcase/
    - widgets/map/
    - assets/models/

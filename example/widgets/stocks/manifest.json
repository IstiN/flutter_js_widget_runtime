{
  "id": "stocks",
  "name": "Stock Prices",
  "description": "Real-time stock quotes",
  "version": "1.0.2",
  "icon": "\ud83d\udcc8",
  "allowedCommands": [],
  "network": true,
  "cli": {
    "summary": "Real-time stock quotes (Yahoo Finance)",
    "events": [
      {
        "id": "refresh",
        "description": "Reload quotes"
      },
      {
        "id": "back",
        "description": "Return from chart view to list"
      },
      {
        "id": "apply_symbols",
        "description": "Set symbols from field (payload: {\"value\":\"AAPL,MSFT\"})"
      },
      {
        "id": "symbol_input_change",
        "description": "Symbols field changed (payload: {\"value\":\"...\"})"
      },
      {
        "id": "show_chart_<symbol>",
        "description": "Open intraday chart, e.g. show_chart_AAPL"
      }
    ],
    "read": {
      "state": "jsr app:state stocks \u2014 quotes[] with price and changePct",
      "snapshot": "jsr app:snapshot stocks"
    },
    "examples": [
      "jsr app:run stocks",
      "jsr app:execute stocks apply_symbols '{\"value\":\"AAPL,TSLA\"}'",
      "jsr app:state stocks"
    ]
  }
}
